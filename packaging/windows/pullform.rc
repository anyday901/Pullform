// Windows resources: application icon and version information.
#include <winver.h>

IDI_ICON1 ICON "../../assets/icons/pullform.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,2,0,0
 PRODUCTVERSION 0,2,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Pullform contributors"
      VALUE "FileDescription", "Pullform 3D modeler"
      VALUE "FileVersion", "0.2.0"
      VALUE "InternalName", "Pullform"
      VALUE "LegalCopyright", "MIT License, Pullform contributors"
      VALUE "OriginalFilename", "Pullform.exe"
      VALUE "ProductName", "Pullform"
      VALUE "ProductVersion", "0.2.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
